# Plantilla de entorno para la suite de tests (APP_ENV=testing).
#
# Laravel carga este archivo automaticamente cuando APP_ENV=testing (ya seteado en phpunit.xml).
# Copiar este archivo a ".env.testing" (sin ".example") y completar segun tu entorno local.
# ".env.testing" esta en .gitignore: no se versiona, no lleva credenciales reales.
#
# IMPORTANTE: DB_DATABASE debe contener la palabra "testing" (ej. empresa_testing). La clase base
# ComprasTestCase aborta la suite si la base conectada no contiene "testing" en el nombre, como
# seguro contra correr los tests sobre la base de desarrollo por error.
#
# IMPORTANTE: despues de copiar este archivo, correr `php artisan config:clear` antes de ejecutar
# `migrate:fresh --env=testing`. Laravel cachea la config en memory: si la config se habia cargado
# con otro .env antes, la clave `engine` de config/database.php seguira siendo null hasta que se
# limpie el cache.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=empresa_testing
DB_USERNAME=
DB_PASSWORD=

# Motor de tabla de la base de testing. InnoDB es OBLIGATORIO: la suite usa DatabaseTransactions,
# y sobre MyISAM el BEGIN/ROLLBACK no revierte nada, asi que cada test arranca con lo que dejo el
# anterior. Con esta variable, `php artisan migrate:fresh --env=testing` crea todas las tablas en
# InnoDB sin tocar el my.ini de WAMP ni reiniciar el servicio de MySQL.
DB_ENGINE=InnoDB
