# Plantilla de entorno para la suite de tests (APP_ENV=testing).
#
# Laravel carga este archivo automaticamente cuando APP_ENV=testing (ya seteado en phpunit.xml).
# Copiar este archivo a ".env.testing" (sin ".example") y completar segun tu entorno local.
# ".env.testing" esta en .gitignore: no se versiona, no lleva credenciales reales.
#
# IMPORTANTE: DB_DATABASE debe contener la palabra "testing" (ej. empresa_testing). La clase base
# ComprasTestCase aborta la suite si la base conectada no contiene "testing" en el nombre, como
# seguro contra correr los tests sobre la base de desarrollo por error.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=empresa_testing
DB_USERNAME=
DB_PASSWORD=
