{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "afipsdk/afip.php": "^1.2",
        "decidir2/php-sdk": "^1.7",
        "doctrine/dbal": "^3.10",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.7",
        "laravel/framework": "^8.75",
        "laravel/sanctum": "^2.11",
        "laravel/tinker": "^2.5",
        "maatwebsite/excel": "^3.1",
        "milon/barcode": "^11.0",
        "openspout/openspout": "4.32.0",
        "predis/predis": "^3.3",
        "pusher/pusher-php-server": "^7.2",
        "tecnickcom/tcpdf": "^6.10"
    },
    "require-dev": {
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^5.10",
        "phpunit/phpunit": "^9.5.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "app/Http/Controllers/Pdf/reportes/InventarioPdf.php",
            "app/Http/Controllers/Pdf/reportes/ClientesPdf.php",
            "app/Http/Controllers/Pdf/reportes/ReportePdf.php",
            "app/Models/MeLiBuyer.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "comerciocity": {
            "runtime-profile": "vps-php84-v1",
            "base-manifest-sha256": "7ad10e846d094fbe9b63497701a10d45ed8e7c8e169a4fc69172614dd1ff1ce1",
            "base-lock-sha256": "b4611aa89f2feda87c84b55b07ddf0e4d7a8dc54e2721ee751da547fecc7327c"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.27"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
