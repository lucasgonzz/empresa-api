APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Minutos que el snapshot del tablero de rendimiento se reutiliza antes de recalcularse.
# El default es 10. Bajarlo a 1 hace que practicamente cada visita al tablero rehaga todas
# las cuentas: es lo que venia por defecto y lo que hacia que un cliente con muchos datos
# clavara la CPU.
# DURACION_REPORTES=10
# URL base de la API, SIN "/public" y SIN barra final, tanto en VPS como en hosting compartido.
# El "/public" lo agrega el codigo automaticamente segun VPS/APP_ENV (ver ApiUrlHelper).
APP_URL=http://localhost
# true solo en VPS, donde el documento raiz ya apunta a public/. En hosting compartido: false.
VPS=false
# API_URL esta deprecada: no la cargues en instalaciones nuevas. Si no esta definida, cae en
# APP_URL automaticamente (ver config/app.php).
# API_URL=
# URL del SISTEMA de este cliente (lo que el dueno abre en el navegador), sin barra final. NO es
# APP_URL: APP_URL es la de la API. Con esta cargada, el informe de la manana que el asistente le
# manda al dueno por WhatsApp viaja con un link que lo abre desde el telefono; sin ella, el informe
# se manda igual pero SIN link (mision asistente-por-whatsapp, 16/9/2026). No tiene repliegue a
# proposito: un link armado con APP_URL da 404 en el telefono y nadie se entera.
# SPA_URL=https://cliente.comerciocity.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Conexiones persistentes al MySQL (PDO::ATTR_PERSISTENT). Apagada por defecto: sin esta linea, la
# conexion se arma exactamente igual que siempre.
# Prendela cuando el hosting limite las conexiones NUEVAS por segundo y la instancia empiece a tirar
# "SQLSTATE[HY000] [2002] Operation not permitted" - el caso del shared hosting de Hostinger, donde
# el tope es de la cuenta entera y lo comparten todos los clientes (7/9/2026: entraban ~18 en rafaga
# y despues se rechazaban todas). En un VPS con la base propia no hace falta.
# DB_PERSISTENT=true

# pusher: eventos de soporte a empresa-spa (mismas claves que admin-api + Vite).
BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Que el scheduler dispare `queue:work --stop-when-empty` cada minuto.
# Dejalo en true (el default) donde el unico que drena la cola es el cron: el shared hosting.
# Ponelo en false donde ya hay un worker de supervisor vivo -el VPS-, porque ahi cada arranque
# de artisan es medio segundo de CPU tirado y son ~80 por minuto entre todos los frentes.
# QUEUE_SCHEDULER_WORKER=false


MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

COMMERCIOCITY_BRAND_NAME=ComercioCity
COMMERCIOCITY_LOGO_URL=
COMMERCIOCITY_HEADER_BG=#38bdf8
COMMERCIOCITY_WEBSITE_URL=https://commerciocity.com
COMMERCIOCITY_INSTAGRAM_URL=https://instagram.com/commerciocity
COMMERCIOCITY_WEBSITE_LABEL=Sitio web
COMMERCIOCITY_INSTAGRAM_LABEL=Instagram
COMMERCIOCITY_FOOTER_LEGAL_HTML=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
# Techo de la llamada HTTP a Pusher, en segundos. Default 5.
# Desde el 31/8/2026 los avisos en tiempo real salen sin pasar por la cola, asi que un Pusher
# lento clava al worker ese tiempo por notificacion. Bajalo en una instancia con red mala.
# PUSHER_TIMEOUT=5
# SSL al API REST de Pusher (Guzzle). En local por defecto verify=false si APP_ENV!=production.
# PUSHER_GUZZLE_VERIFY_SSL=false
# PUSHER_GUZZLE_CA_BUNDLE="C:/path/cacert.pem"
# Espacio de nombres de los canales (mision pusher-canales-por-sistema, 19/10/2026). Toda la flota
# emite a una sola app de Pusher; cada canal sale con el sufijo @{espacio}, que se CALCULA solo con
# la base, el APP_ENV y el secret de Pusher. Dejalo vacio: es un override para tests o para alinear
# a mano empresa-api y tienda-api de un mismo cliente (los dos con EL MISMO valor; minusculas y
# digitos, hasta 32). `php artisan canales:espacio` muestra el espacio de cada lado.
BROADCAST_ESPACIO=
# Canales que cruzan ERP <-> tienda: true = transicion (se emiten con y sin espacio; default),
# false = estricto (solo con espacio). El estricto se prende en empresa-api Y en tienda-api del mismo
# cliente a la vez, cuando los dos ya estan en la version nueva. Vacio o mal tipeado = transicion.
BROADCAST_CANALES_VIEJOS_DE_TIENDA=true

# SSL hacia api.mercadolibre.com (cURL error 60 en WAMP). Por defecto verify=false si APP_ENV no es production.
# MERCADO_LIBRE_GUZZLE_VERIFY_SSL=false
# MERCADO_LIBRE_GUZZLE_CA_BUNDLE="C:/wamp64/bin/php/php8.x.x/extras/ssl/cacert.pem"

# Mercado Libre (mision mercado-libre-integracion, 27/10/2026). Ver config/services.php 'mercadolibre'.
# El modulo se prende por cliente con la extension `usa_mercado_libre` (USA_MERCADO_LIBRE=true es el
# interruptor viejo, sigue andando). Credenciales de la APP de ComercioCity en ML (no del comercio):
# si la fila `mercado_libre` de `platforms` las tiene completas, ganan esas.
MERCADO_LIBRE_CLIENT_ID=
MERCADO_LIBRE_CLIENT_SECRET=
# URL central del admin a la que ML vuelve despues de autorizar (la unica registrada en la app de ML).
# Vacia (MERCADO_LIBRE_OAUTH_RELAY_URL=) = se usa MERCADO_LIBRE_REDIRECT_URI, la callback propia.
# MERCADO_LIBRE_OAUTH_RELAY_URL=https://api-admin.comerciocity.com/api/mercadolibre/callback
# MERCADO_LIBRE_REDIRECT_URI=https://<api-del-cliente>/platform-connector/mercadolibre/callback
# Un pedido PAGO de ML genera la venta solo (y baja el stock). false = la venta se genera a mano.
# MERCADO_LIBRE_CREAR_VENTA_AUTOMATICA=true
# Ritmo de la sincronizacion de articulos: tope por corrida y pausa minima entre llamadas (ms).
# MERCADO_LIBRE_MAX_POR_CORRIDA=30
# Tope de pedidos por consulta periodica (cada 5 min); si queda cortada se avisa al duenio una vez.
# MERCADO_LIBRE_MAX_PEDIDOS_POR_CONSULTA=1000
# MERCADO_LIBRE_MS_ENTRE_LLAMADAS=250
# Base del backoff ante un 429/5xx de ML (ms; 1 s, 2 s, 4 s) y espera ante un 409 (ms).
# MERCADO_LIBRE_BACKOFF_MS=1000
# MERCADO_LIBRE_ESPERA_409_MS=2000

# OAuth de Mercado Pago (grupo 170, prompt 598): credenciales de la app de ComercioCity dada de
# alta en Mercado Pago Developers, NO de cada comercio (esas se guardan por comercio en
# platform_connectors; hasta la mision de ABM -> Integraciones vivian en online_configuration).
MP_APP_ID=
MP_APP_SECRET=
# URL CENTRAL del admin a la que Mercado Pago redirige tras autorizar, igual para todos los
# clientes (mision mp-redireccion-central-admin, 17/10/2026). Si no se define, el default de
# config/services.php ya es https://api-admin.comerciocity.com/api/mercadopago/callback, asi que
# NO hace falta cargarla en el .env de cada cliente. El admin reenvia el callback al backend del
# cliente segun el host que viaja en el `state`. Dejarla VACIA (MP_OAUTH_RELAY_URL=) la apaga y
# se usa MP_OAUTH_REDIRECT_URI: sirve en desarrollo local, donde el admin no llega a tu maquina.
# MP_OAUTH_RELAY_URL=
# LEGACY: solo se usa si MP_OAUTH_RELAY_URL esta vacia. Antes era la callback propia de cada
# cliente y habia que registrarla una por una en Mercado Pago (con SMS al celular de Lucas).
MP_OAUTH_REDIRECT_URI=http://localhost/empresa/empresa-api/public/api/integraciones/mercadopago/callback
# Pantalla a la que vuelve el navegador del comercio despues del callback. El SPA rutea
# /abm/:view?/:sub_view?, asi que el SEGUNDO SEGMENTO ES OBLIGATORIO: sin `tienda-online` el ABM
# abre la solapa "Sistema" y el aviso de retorno del OAuth (?mp=ok / ?mp=error) nunca corre, con
# lo cual el comercio conecta bien y no se entera.
MP_OAUTH_SPA_REDIRECT_URL=http://localhost:8080/abm/integraciones/tienda-online

# Solo en instancias de demo (mision mp-precio-servidor-y-credenciales-env, 16/9/2026): si estan
# las dos cargadas y la instancia todavia no tiene ninguna cuenta de Mercado Pago conectada,
# demoSetup conecta sola con estas credenciales. No pisa una conexion que ya exista.
# RESPALDO: desde el 14/10/2026 (mision credenciales-demo-zipnova-mp) lo normal es cargar las
# credenciales de prueba de las demos en el admin (Configuracion > Implementacion): el demo-setup
# las recibe en el payload y GANAN a estas variables. Lo mismo vale para ZIPNOVA_DEMO_API_TOKEN,
# ZIPNOVA_DEMO_API_SECRET y ZIPNOVA_DEMO_ACCOUNT_ID (config/services.php).
# MERCADOPAGO_DEMO_ACCESS_TOKEN=
# MERCADOPAGO_DEMO_PUBLIC_KEY=

# Zippin comparte pantalla con Mercado Pago (misma solapa "Tienda online"), asi que su URL de
# retorno es la misma. Estaba leyendose en config/services.php sin estar documentada aca.
ZIPPIN_OAUTH_SPA_REDIRECT_URL=http://localhost:8080/abm/integraciones/tienda-online

# Zipnova (ex Zippin), misión zipnova-envios (14/9/2026). Sin credenciales acá: cada comercio pega
# su API Token + API Secret en ABM -> Integraciones y quedan cifrados en platform_connectors.
# Solo hace falta descomentar si Zipnova cambia el host o para apuntar a un stub local.
# ZIPNOVA_BASE_URL=https://api.zipnova.com.ar/v2
# ZIPNOVA_TIMEOUT=20
# ZIPNOVA_REINTENTO_429=true
# ZIPNOVA_GUZZLE_VERIFY_SSL=true
# ZIPNOVA_GUZZLE_CA_BUNDLE="C:/wamp64/bin/php/cacert.pem"

# SSL hacia Google Custom Search (batch imágenes). Por defecto verify=false si APP_ENV no es production.
# GOOGLE_CUSTOM_SEARCH_GUZZLE_VERIFY_SSL=false
# GOOGLE_CUSTOM_SEARCH_GUZZLE_CA_BUNDLE="C:/wamp64/bin/php/php8.x.x/extras/ssl/cacert.pem"

# Serper (Google Imágenes por API), misión imagenes-catalogo-completo (27/9/2026): el proveedor de
# búsqueda de las asignaciones inteligentes de imágenes. Sin esta clave NO se puede lanzar "buscar
# imágenes para todo el catálogo" (acceso maestro) y las asignaciones por selección siguen con Google
# Custom Search. Usa el mismo TLS que Google Custom Search (GOOGLE_CUSTOM_SEARCH_GUZZLE_*).
# Es el RESPALDO (misión serper-en-user-setup, 28/9/2026): si el dueño tiene su clave en
# users.serper_api_key (la manda el admin al instalar), gana la del dueño y esta no se usa.
# SERPER_API_KEY=
# Opcional: país e idioma de la búsqueda (por defecto Argentina y español).
# SERPER_GL=ar
# SERPER_HL=es
# Opcional: artículos como máximo por cada lanzamiento de "todo el catálogo" (5000 = una noche).
# IMAGENES_TOPE_CATALOGO=5000
# Opcional: segundos que trabaja cada tramo del job antes de re-encolarse (siempre hace al menos 1 artículo;
# se acota a 20..90).
# IMAGENES_SEGUNDOS_POR_TRAMO=50

# UPCitemdb (descripciones inteligentes por GTIN). Plan FREE sin API key.
# LIMITE REAL: 100 requests/dia POR IP, compartidos por TODOS los clientes de la plataforma
# (no 100 por cliente). daily_cap deja margen antes de ese techo de 100.
# UPCITEMDB_ENABLED=true
# UPCITEMDB_DAILY_CAP=90
# UPCITEMDB_TIMEOUT=8

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Categorización con IA en tres modelos (misión categorizacion-tres-modelos, 5/10/2026).
# Opcional: artículos vivos como máximo sobre los que se arma una corrida de categorías (default 6000:
# elegir un sistema es sincrónico y con 10000 tarda más de 15 segundos).
# CATALOGO_IA_TOPE_ARTICULOS=6000

# Integración con admin-api (sistema central de releases/versiones)
ADMIN_API_URL=http://localhost/empresa/admin-api/public
# Clave que admin-api manda en X-Admin-Api-Key hacia esta instancia (tiene que coincidir con clients.api_key
# del admin). Con ella cargada, las rutas api/admin-sync/* EXIGEN la clave sin tocar nada más (ver abajo).
# Una instancia sin clave (demo, entorno de test) deja esas rutas abiertas: no hay con qué comparar.
ADMIN_API_INBOUND_KEY=
ADMIN_API_OUTBOUND_KEY=
ADMIN_API_CLIENT_UUID=
# Exigencia de la clave en api/admin-sync/* (middleware AdminApiKey). Tres estados:
#   - sin definir (o vacía): automático. Exige la clave si ADMIN_API_INBOUND_KEY está cargada; si no, no exige.
#   - true:  exige siempre la clave.
#   - false: no exige nunca (apagado a propósito; deja esas rutas abiertas aunque haya clave).
# ADMIN_SYNC_REQUIRE_API_KEY=
#   ⚠️ Con esta variable en `true`, los avisos del cliente hacia el admin (mensajes de soporte y acuses de lectura de
#   novedades) también exigen que ADMIN_API_OUTBOUND_KEY esté cargada: sin ella dejan de salir. Si la prendés a mano,
#   cargá antes ADMIN_API_OUTBOUND_KEY (= clients.inbound_api_key en el admin). Dejándola SIN DEFINIR no pasa nada de eso.
# Exige X-Admin-Api-Key en POST admin-sync/user-setup. Apagada a propósito: admin-api todavía no manda
# el header a esa ruta y prenderla antes rompe el alta de clientes (la protege la guarda de datos de
# UserSetupHelper). Prenderla (true) recién cuando admin-api lo mande, con ADMIN_API_INBOUND_KEY cargada.
# Es independiente de ADMIN_SYNC_REQUIRE_API_KEY (el flag global NO la prende, a propósito).
ADMIN_SYNC_SETUP_REQUIRE_API_KEY=false

# API de Anthropic (Claude) — requerida para la funcionalidad de importación Excel con IA.
# Obtené tu clave en https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Opcional: los tres niveles de "cómo piensa" el asistente (users.agente_pensamiento). Sin definir,
# caen a los defaults de config/services.php (agil=Haiku, equilibrado y profundo=ANTHROPIC_MODEL/Opus).
#ANTHROPIC_MODEL_AGIL=claude-haiku-4-5-20251001
#ANTHROPIC_MODEL_EQUILIBRADO=claude-sonnet-5
#ANTHROPIC_MODEL_PROFUNDO=claude-opus-5
# Opcional: ruta a cacert.pem (https://curl.se/ca/cacert.pem) para evitar cURL error 60 en Windows/WAMP.
#ANTHROPIC_CAINFO=C:/wamp64/certs/cacert.pem
# Solo entorno local sin CA en php.ini: false (no usar en producción).
#ANTHROPIC_VERIFY_SSL=false
# Opcional: base de la API de Anthropic (solo para apuntar a un proxy; el default es la real).
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# API de DeepSeek — el segundo proveedor del asistente (misión proveedores-ia-deepseek). El dueño
# elige entre Claude y DeepSeek desde "Configurá tu asistente"; sin esta clave DeepSeek aparece como
# "no disponible en esta instalación" y no se puede elegir. Obtené la clave en https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# Opcional: se le pega por el endpoint compatible con Anthropic (mismo payload de /v1/messages).
#DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Opcional: los modelos. `model` es el general (título de conversación); agil y profundo son los
# dos niveles de "cómo piensa" (DeepSeek no tiene "equilibrado": cae a agil). Desde el 30/9/2026
# agil es también "DeepSeek Flash" y profundo "DeepSeek Pro" en los modelos por cliente del admin.
#DEEPSEEK_MODEL=deepseek-flash
#DEEPSEEK_MODEL_AGIL=deepseek-flash
#DEEPSEEK_MODEL_PROFUNDO=deepseek-v4-pro
# Opcional: el modelo con visión; cuando el dueño manda una foto y está en Profundo, esa llamada va
# con este modelo (Pro no ve imágenes y DeepSeek no avisa: contesta sin mirar la foto).
#DEEPSEEK_MODEL_VISION=deepseek-flash
# Opcional: el thinking de DeepSeek viene prendido por defecto; agil lo apaga y profundo lo prende.
#DEEPSEEK_THINKING_AGIL=disabled
#DEEPSEEK_THINKING_PROFUNDO=enabled
# Opcional: techo de tokens de salida cuando el thinking va prendido (profundo). Si el endpoint
# cuenta el razonamiento contra max_tokens, los 1500 del asistente pueden cortar sin texto; con esto
# el payload sube el techo a este valor. No cambia el costo: se paga por token generado.
#DEEPSEEK_MAX_TOKENS_PROFUNDO=8000
# Opcional: budget_tokens que acompaña al thinking prendido. DeepSeek lo ignora, pero el esquema de
# Anthropic (que ese endpoint imita) lo exige con enabled: va por si su validacion lo copia. Menor que el techo.
#DEEPSEEK_THINKING_BUDGET_TOKENS=4000
# Opcional: con true (default), un turno escalado con fotos corre en Pro pensando y las fotos le llegan
# transcriptas por el modelo con visión (una llamada al arrancar el turno). Con false, el turno con foto
# corre en el modelo con visión, como antes. Sirve para comparar las dos formas.
#DEEPSEEK_PRO_CON_TRANSCRIPCION=true
# Opcional: TLS. Sin definir, caen a ANTHROPIC_CAINFO / ANTHROPIC_VERIFY_SSL (misma máquina, mismo cacert).
#DEEPSEEK_CAINFO=C:/wamp64/certs/cacert.pem
#DEEPSEEK_VERIFY_SSL=false

# Modelos de IA por cliente (misión modelos-ia-por-cliente, 30/9/2026): el admin elige, por cliente,
# el modelo del asistente, del bot de WhatsApp, de la verificación de imágenes y de la importación de
# Excel. Por defecto todo va a DeepSeek (Flash; Excel en Pro), así que DEEPSEEK_API_KEY es la que
# hace falta. Sin ella, cada tarea cae a Anthropic con el modelo que usaba antes (el "legado").

# Validación de imagen por visión IA (grupo 201): antes de asignar una imagen de Google a un
# artículo, se le pide a la IA que confirme que la imagen es realmente del producto. Usa la clave
# del proveedor elegido (DEEPSEEK_API_KEY por defecto; ANTHROPIC_API_KEY si cae a Claude).
#ARTICLE_IMAGE_VALIDATION_ENABLED=true
# Modelo LEGADO de Claude: se usa cuando la tarea cae a Anthropic por falta de clave de DeepSeek.
#ARTICLE_IMAGE_VALIDATION_MODEL=claude-haiku-4-5-20251001
#ARTICLE_IMAGE_VALIDATION_TIMEOUT=25
#ARTICLE_IMAGE_VALIDATION_MAX_SIDE=512
#ARTICLE_IMAGE_VALIDATION_MAX_CALLS_BATCH=300

# Importación de Excel con IA (identificar columnas y la recomendación). Default del cliente:
# DeepSeek Pro. Modelo LEGADO de Claude (el de antes del 30/9/2026), para cuando cae a Anthropic
# por falta de clave de DeepSeek, y timeout de la llamada en segundos (Pro razona y tarda más).
#IMPORTACION_EXCEL_IA_MODEL_ANTHROPIC=claude-sonnet-4-5
#IMPORTACION_EXCEL_IA_TIMEOUT=120
# Techo de salida cuando la IA razona (DeepSeek Pro): si la respuesta se corta por el techo, la
# importación dice "no se pudo interpretar" y queda un warning en el log. No cambia el costo.
#IMPORTACION_EXCEL_IA_MAX_TOKENS_CON_RAZONAMIENTO=16000

# Escaneo de facturas de compra con IA (misión escaneo-factura-compra): el usuario fotografía
# la factura del proveedor y el sistema extrae la tabla de artículos y los datos del
# comprobante. Reutiliza ANTHROPIC_API_KEY / ANTHROPIC_CAINFO / ANTHROPIC_VERIFY_SSL de arriba.
# Ojo con el modelo: acá NO conviene uno económico, leer una tabla impresa chica y sacar
# códigos exactos es la parte cara de la funcionalidad.
#ESCANEO_FACTURA_MODEL=claude-sonnet-5
#ESCANEO_FACTURA_TIMEOUT=180
#ESCANEO_FACTURA_MAX_SIDE=1568
#ESCANEO_FACTURA_MAX_IMAGENES=6
#ESCANEO_FACTURA_MAX_MB=12
#ESCANEO_FACTURA_MAX_TOKENS=16000

# Embeddings vectoriales del catálogo (búsqueda semántica del agente de WhatsApp con IA):
# generación inmediata al crear/editar un artículo (ArticleObserver/DescriptionObserver) y
# barrido cada 30 min (articles:generate-embeddings, ver Kernel.php), solo si el usuario tiene
# la extensión whatsapp_ia. EMBEDDINGS_OMITIR_IMPORTACION apaga además el disparo posterior a una
# importación de Excel (FinalizeArticleImport) y el scheduler entero: pensada para instancias de
# demo, donde un lead que sube un Excel de prueba no tiene que generarle embeddings a nada. La
# creación manual de un artículo no la mira y sigue funcionando igual. Default false: ningún
# cliente real la necesita.
#EMBEDDINGS_OMITIR_IMPORTACION=false

# Pausa global de la generación de embeddings (misión busqueda-lenta-y-pausa-embeddings,
# 14/9/2026), independiente de whatsapp_ia: corta las tres puntas (scheduler, disparo
# post-importación y creación/edición manual de un artículo) en TODO el parque de un saque, sin
# ir comercio por comercio. No apaga la búsqueda del bot de WhatsApp (esa depende solo de
# whatsapp_ia): los embeddings que ya existen se siguen usando, lo único que corta es generar
# nuevos. Se lee vía config/services.php (services.openai.embeddings_generacion_pausada), nunca
# con env() directo en el código — mismo motivo que EMBEDDINGS_OMITIR_IMPORTACION de arriba, con
# más razón acá porque el caso de uso real es prenderla en un .env de producción con config
# cacheado. Default false: ningún cliente nota que existe hasta que alguien la prenda a mano.
#EMBEDDINGS_GENERACION_PAUSADA=false

# Secretos sacados del código (grupo 220, prompt 02): antes vivían hardcodeados en AfipSdk.php,
# seeders y controllers. El repositorio es público, así que ahora se leen del .env del servidor;
# el default en config/services.php siempre queda vacío.

# Access token + CUIT de la cuenta de app.afipsdk.com (antes hardcodeados en AfipSdk.php).
AFIP_SDK_ACCESS_TOKEN=
AFIP_SDK_CUIT=

# Tokens de una cuenta de Mercado Libre, usados solo por los seeders de desarrollo
# (MeliPlatformConnectorSeeder / MercadoLibreTokenSeeder) para sembrar un conector de ejemplo.
MERCADO_LIBRE_SEED_ACCESS_TOKEN=
MERCADO_LIBRE_SEED_REFRESH_TOKEN=

# Access token de una cuenta de prueba de Mercado Pago, usado solo por PaymentMethodSeeder para
# sembrar el medio de pago de ejemplo.
MERCADO_PAGO_SEED_ACCESS_TOKEN=

# API key de fallback global de Google Custom Search (se usa cuando un User no tiene la suya
# propia configurada). Antes estaba hardcodeada en UserSeeder, set_datos_for_demo, GoogleController
# y ArticleDescriptionAiController.
GOOGLE_SEARCH_API_KEY=


# Auditoría de cambios (misión auditoria-de-cambios): un listener global deja una fila en la tabla
# `audit_logs` por cada cambio que el sistema hace en la base por Eloquent (qué cambió, quién y desde
# dónde). Está prendido por defecto; esta variable es solo la salida de emergencia: con `false` no se
# escribe nada. Se lee con config('audit_log.habilitado'), nunca con env() directo.
# AUDIT_LOG_HABILITADO=true

# Rutas de mantenimiento (routes/mantenimiento.php): true las abre sin clave; solo para el entorno local (no se abren por APP_ENV=local).
RUTAS_DE_MANTENIMIENTO=false
# sha256 de la clave maestra de mantenimiento para ESTE cliente; vacío = el que trae el código (config/app.php).
MANTENIMIENTO_CLAVE_SHA256=
